#!/bin/bash

# ========================================================================
#  Nafees's VHost Fuzzer v1.0
#  Purpose -- Automated vhost enumeration using ffuf
# =============================================================================

#terminal_colour 
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to display script usage
show_help() {
    echo -e "${BLUE}-----------------------------------------------${NC}"
    echo -e "${GREEN}  Nafees's VHost Fuzzer v1.0${NC}"
    echo -e "${BLUE}-----------------------------------------------${NC}"
    echo "Usage: $0 <DOMAIN> <WORDLIST> <URL> <FS Filter>"
    echo "   -h, --help     Display this help and exit"
    echo
    echo "This script is a custom vhost fuzzer using ffuf with logging & branding."
    echo "Designed for Nafees Nif | Cybersecurity Student & Pentester"
}

# Check if the help option is provided
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    show_help
    exit 0
fi

# Check if the required arguments are provided
if [ "$#" -ne 4 ]; then
    echo -e "${RED}Error: Missing or incorrect arguments.${NC}"
    show_help
    exit 1
fi

# Assign arguments to variables
DOMAIN="$1"
WORDLIST="$2"
URL="$3"
FS="$4"

# Create timestamp and output directory
TIMESTAMP=$(date +"%Y-%m-%d_%H-%M-%S")
OUTPUT_DIR="scans/$DOMAIN"
mkdir -p "$OUTPUT_DIR"
OUTPUT_FILE="$OUTPUT_DIR/results_$TIMESTAMP.json"

# Print branding and target info
echo -e "${BLUE}-----------------------------------------------${NC}"
echo -e "${GREEN}  Nafees's VHost Fuzzer v1.0${NC}"
echo -e "${YELLOW}  Target Domain: $DOMAIN${NC}"
echo -e "${YELLOW}  Wordlist: $WORDLIST${NC}"
echo -e "${YELLOW}  URL: $URL${NC}"
echo -e "${YELLOW}  Filter Size: $FS${NC}"
echo -e "${BLUE}-----------------------------------------------${NC}"
echo -e "${GREEN}[*] Starting scan at $TIMESTAMP...${NC}"

# Run ffuf command with custom headers and output logging
ffuf \
    -H "Host: FUZZ.$DOMAIN" \
    -H "User-Agent: NAFEES_SEC_RESEARCH" \
    -c \
    -w "$WORDLIST" \
    -u "$URL" \
    -mc 200 \
    -o "$OUTPUT_FILE" \
    -of json
# Check if ffuf succeeded
if [ $? -eq 0 ]; then
    echo -e "${GREEN}[+] Scan completed successfully!${NC}"
    echo -e "${GREEN}[+] Results saved to: $OUTPUT_FILE${NC}"
    
    # Optional: Ask to copy results path to clipboard (if xclip is available)
    if command -v xclip &> /dev/null; then
        echo -n "Copy results file path to clipboard? (y/n): "
        read answer
        if [[ "$answer" == "y" || "$answer" == "Y" ]]; then
            echo "$OUTPUT_FILE" | xclip -selection clipboard
            echo -e "${GREEN}[+] Path copied to clipboard!${NC}"
        fi
    fi
else
    echo -e "${RED}[-] Scan failed. Check ffuf output above.${NC}"
    exit 1
fi

echo -e "${BLUE}-----------------------------------------------${NC}"
echo -e "${GREEN}  Scan finished by Nafees's VHost Fuzzer${NC}"
echo -e "${BLUE}-----------------------------------------------${NC}"
