#!/bin/bash

show_help() {
    echo "Usage: $0 <DOMAIN> <WORDLIST> <URL>"
    echo "   -h, --help     Display this help and exit"
    echo
    echo "This script is a vhost fuzzer using ffuf."
}

# Help option
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    show_help
    exit 0
fi

# Must be exactly 3 arguments now
if [ "$#" -ne 3 ]; then
    echo "Error: Missing or incorrect arguments."
    show_help
    exit 1
fi

DOMAIN="$1"
WORDLIST="$2"
URL="$3"

ffuf \
    -H "Host: FUZZ.$DOMAIN" \
    -H "User-Agent: NAFEES_SEC_RESEARCH" \
    -c \
    -w "$WORDLIST" \
    -u "$URL" \
    -mc 200
