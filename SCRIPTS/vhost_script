#!/bin/bash

# =============================================================================
#  Nafees Nif - VHost Hunter v2.0
#  Custom virtual host (vhost) fuzzer wrapper around ffuf
#  Stack       : Bash + ffuf
#  Use case    : Bug bounty / THM / HTB labs
# =============================================================================

# COLOUR_BANNER
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
NC='\033[0m' # No Color

# ----- Banner -----
banner() {
    echo -e "${BLUE}=========================================================${NC}"
    echo -e "${PURPLE}   Nafees Nif :: VHost Hunter v2.0 ${NC}"
    echo -e "${BLUE}=========================================================${NC}"
}

# ----- Help -----
show_help() {
    banner
    echo -e "${YELLOW}Usage:${NC} $0 <DOMAIN> <WORDLIST> <URL>"
    echo
    echo "  DOMAIN   : Base domain for vhost fuzzing (e.g. creative.thm)"
    echo "  WORDLIST : Path to subdomain/vhost wordlist"
    echo "  URL      : Full URL to send requests to (e.g. http://creative.thm)"
    echo
    echo "Example:"
    echo "  $0 creative.thm /path/to/wordlist.txt http://creative.thm"
    echo
    echo "Notes:"
    echo "  - This wrapper matches only HTTP 200 responses (-mc 200)."
    echo "  - Make sure DOMAIN is in /etc/hosts resolving to the target IP."
}

# ----- Help flags -----
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    show_help
    exit 0
fi

# ----- Arg check -----
if [ "$#" -ne 3 ]; then
    echo -e "${RED}[!] Error: Missing or incorrect arguments.${NC}"
    show_help
    exit 1
fi

DOMAIN="$1"
WORDLIST="$2"
URL="$3"

# ----- Basic sanity checks -----
if [ ! -f "$WORDLIST" ]; then
    echo -e "${RED}[!] Wordlist not found:${NC} $WORDLIST"
    exit 1
fi

# Check ffuf availability
if ! command -v ffuf > /dev/null 2>&1; then
    echo -e "${RED}[!] ffuf is not installed or not in PATH.${NC}"
    exit 1
fi

# ----- Output -----
TIMESTAMP=$(date +"%Y-%m-%d_%H-%M-%S")
OUTPUT_DIR="scans/$DOMAIN"
mkdir -p "$OUTPUT_DIR"
OUTPUT_FILE="$OUTPUT_DIR/vhost_$TIMESTAMP.json"

# ----- Run info -----
banner
echo -e "${GREEN}[+] Target Domain :${NC} $DOMAIN"
echo -e "${GREEN}[+] Wordlist      :${NC} $WORDLIST"
echo -e "${GREEN}[+] URL           :${NC} $URL"
echo -e "${GREEN}[+] Match Codes   :${NC} 200 only"
echo -e "${GREEN}[+] Output File   :${NC} $OUTPUT_FILE"
echo

# ----- ffuf execution -----
ffuf \
    -H "Host: FUZZ.$DOMAIN" \
    -H "User-Agent: NAFEES_VHOST_HUNTER" \
    -c \
    -w "$WORDLIST" \
    -u "$URL" \
    -mc 200 \
    -o "$OUTPUT_FILE" \
    -of json

FFUF_EXIT=$?

if [ $FFUF_EXIT -eq 0 ]; then
    echo
    echo -e "${GREEN}[+] Scan completed successfully.${NC}"
    echo -e "${GREEN}[+] Results saved to:${NC} $OUTPUT_FILE"
else
    echo
    echo -e "${RED}[!] ffuf exited with error code:${NC} $FFUF_EXIT"
    echo -e "${YELLOW}[i] Check the ffuf output above for details.${NC}"
    exit $FFUF_EXIT
fi

echo
echo -e "${BLUE}=========================================================${NC}"
echo -e "${PURPLE}   Run completed :: Nafees's VHost Hunter v2.0${NC}"
echo -e "${BLUE}=========================================================${NC}"
